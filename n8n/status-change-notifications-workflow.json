      "position": [
        448,
        0
      ],
      "id": "d936ef60-0f14-44a4-a8b1-b01417d28210",
      "name": "Get All Tasks"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Converts the keyed /tasks object into an array and keeps only externally-created tasks\n * whose status has changed since the last notification (status !== lastNotifiedStatus).\n * Runs \"Once for All Items\" so this executes exactly once per schedule tick, not once per task.\n */\nconst tasksObj = $input.first().json;\nconst results = [];\n\nfor (const [id, task] of Object.entries(tasksObj || {})) {\n  if (task.creatorType === \"external\" && task.status !== task.lastNotifiedStatus) {\n    results.push({ json: { id, ...task } });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "1f387dcd-7300-4364-875c-ecca45121b0b",
      "name": "Filter Status Changes"
    },
    {
      "parameters": {
        "fromEmail": "join@christopher-braun-dev.de",
        "toEmail": "={{ $json.creatorEmail }}",
        "subject": "=Update on your request: {{ $json.title }}",
        "emailFormat": "text",
        "text": "=Hi,\n\nThe status of your ticket \"{{ $json.title }}\" has been updated to: {{ $json.status }}.\n\nBest,\nThe Join Team",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        896,
        0
      ],
      "id": "ec7b77ef-e004-4d9b-8ee6-d254d4023982",
      "name": "Send Status Update",
      "webhookId": "5817dbbd-1782-470d-95a1-1b3265f2211c",
      "credentials": {
        "smtp": {
          "id": "fUkD98Usr5zT9A46",
          "name": "SMTP JOIN"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://join-issue-collector-89dfb-default-rtdb.europe-west1.firebasedatabase.app/tasks/{{ $('Filter Status Changes').first().json.id }}.json?auth={{ $('Sign In Anonymously').first().json.idToken }}\n\n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lastNotifiedStatus: $('Filter Status Changes').first().json.status }) }}\n\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
