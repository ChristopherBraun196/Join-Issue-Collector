        "method": "POST",
        "url": "=https://join-issue-collector-89dfb-default-rtdb.europe-west1.firebasedatabase.app/tasks.json?auth={{ $json.idToken }}\n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": {{ JSON.stringify($('Code in JavaScript').item.json.title) }},\n  \"description\": {{ JSON.stringify($('Email Trigger (IMAP)').item.json.textPlain) }},\n  \"dueDate\": {{ JSON.stringify($('Code in JavaScript').item.json.deadline) }},\n  \"priority\": {{ JSON.stringify($('Code in JavaScript').item.json.priority) }},\n  \"category\": {{ JSON.stringify($('Code in JavaScript').item.json.category) }},\n  \"categoryLabelColor\": {{ JSON.stringify($('Code in JavaScript').item.json.category === \"User Story\" ? \"#0038FF\" : \"#1FD7C1\") }},\n  \"assignedTo\": null,\n  \"subtasks\": null,\n  \"status\": \"triage\",\n  \"creatorType\": \"external\",\n  \"creatorName\": {{ JSON.stringify($('Email Trigger (IMAP)').item.json.from.split('<')[0].trim()) }},\n  \"creatorEmail\": {{ JSON.stringify($('Email Trigger (IMAP)').item.json.from.includes('<') ? $('Email Trigger (IMAP)').item.json.from.split('<')[1].replace('>','') : $('Email Trigger (IMAP)').item.json.from) }},\n  \"isAiGenerated\": true\n}\n",
        "options": {}
