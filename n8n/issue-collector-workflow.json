    {
      "parameters": {
        "jsCode": "/**\n * Parses the AI's JSON-string response (from the Basic LLM Chain node) into a real object\n * so downstream nodes can access category/title/priority/deadline as fields instead of raw text.\n */\nconst parsed = JSON.parse($input.first().json.text);\nreturn [{ json: parsed }];\n"
      },
